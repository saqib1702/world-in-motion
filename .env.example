# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- MongoDB (Atlas) ---
# Atlas: Database > Connect > Drivers > Python. Keep the password URL-encoded.
# Leave MONGO_URI empty to fall back to in-memory mongomock (local/demo only —
# nothing persists between runs).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=world_in_motion
MONGO_TIMEOUT_MS=5000

# --- Gemini ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Run `python scripts/check_connections.py` to see which models your key can
# actually call. If GEMINI_MODEL is not one of them the app logs a warning and
# walks GEMINI_FALLBACK_MODELS in order; if none answer it drops to a mock
# generator whose output is prefixed "[DEMO MODE" so it can never be mistaken
# for live reasoning.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-1.5-flash
# Free-tier Gemini keys are rate limited. The sliding-window limiter throttles to
# this many requests per minute across all threads.
GEMINI_MAX_RPM=5

# --- Flask ---
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
LOG_LEVEL=INFO

# --- Current event ingestion (free GDELT API, no key required) ---
# These queries are a bandwidth filter, not the relevance decision —
# ingestion/fetcher.py entity-matches every result against the modelled actors.
GDELT_QUERY=(sanctions OR tariff OR trade OR diplomacy OR military OR semiconductor OR energy OR summit) (china OR russia OR india OR japan OR brazil OR turkey OR "united states" OR "european union" OR "united kingdom" OR "saudi arabia")
GOOGLE_NEWS_QUERY=geopolitics OR sanctions OR tariffs OR trade war OR diplomatic summit OR military alliance OR semiconductor export controls OR OPEC
EVENT_FETCH_MAX_RECORDS=75
EVENT_FETCH_MAX_ITEMS=6

# --- Scheduled ingestion job ---
# Off by default: every tick spends Gemini tokens. Turn on for a continuous run.
ENABLE_SCHEDULED_INGESTION=false
EVENT_FETCH_INTERVAL_MINUTES=15
SCHEDULED_RUN_ID=scheduled_world_run

# --- Realtime (Socket.IO + Mongo change stream) ---
# The change stream needs a replica set, which Atlas provides but a standalone
# mongod does not. Ticks broadcast directly regardless, so the live graph works
# either way.
ENABLE_RELATION_STREAM=true
# Comma-separated allow-list of browser origins that may open a Socket.IO
# connection. Defaults to the Vite dev server. Set this to your real domain
# before deploying. `*` works but means any page on the internet can open a
# socket to your server; note that engineio only treats the bare string `*` as
# "allow all" — a one-item list containing `*` is compared literally and refuses
# everything, so config.py collapses that case for you.
SOCKETIO_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Security ---
# Shared secret for the two endpoints that cost money: POST /engine/tick runs a
# batched Gemini call for the whole roster, and POST /agents/<id>/chat runs one
# per message. Without a token a single `curl` loop drains your Gemini quota and
# fills your Atlas cluster. Reads stay public so the demo link works for anyone.
#
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Leave it empty for local development and writes are allowed with a logged
# warning. Leave it empty with FLASK_ENV=production and writes return 503 —
# an unconfigured deployment fails closed rather than wide open.
API_TOKEN=
# Same value, exposed to the browser build so the UI can trigger a tick. Vite
# only ships variables prefixed VITE_, and anything shipped to a browser is
# public by definition: use this for a personal/demo deployment, and for a real
# public one leave it unset so visitors get the read-only view.
VITE_API_TOKEN=

# Requests per minute per client IP, per endpoint group. The Gemini limiter
# paces outbound calls; these reject an inbound flood at the door instead.
RATE_LIMIT_TICK=6
RATE_LIMIT_CHAT=20
RATE_LIMIT_READ=240

# Hard caps on anything a caller can send. Bodies over this are refused with 413
# before Flask buffers them; text fields are truncated, which also bounds how
# much attacker-supplied text can reach a Gemini prompt.
MAX_REQUEST_BYTES=65536
MAX_MESSAGE_CHARS=2000
MAX_HEADLINE_CHARS=300
MAX_BODY_CHARS=4000
MAX_CUSTOM_EVENTS=5
