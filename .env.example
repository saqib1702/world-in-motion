# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- MongoDB (Atlas) ---
# Atlas: Database > Connect > Drivers > Python. Keep the password URL-encoded.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=world_in_motion

# --- Gemini ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Flask ---
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
LOG_LEVEL=INFO

# --- Current Event Ingestion (free GDELT API) ---
GDELT_QUERY=(trade OR sanctions OR tariff OR cybersecurity OR semiconductor OR military OR energy OR climate OR diplomacy)
GOOGLE_NEWS_QUERY=geopolitics OR sanctions OR trade OR cybersecurity OR climate treaty OR military alliance OR semiconductor
EVENT_FETCH_MAX_RECORDS=40
EVENT_FETCH_MAX_ITEMS=6

# --- Scheduled Ingestion Job ---
ENABLE_SCHEDULED_INGESTION=false
EVENT_FETCH_INTERVAL_MINUTES=15
SCHEDULED_RUN_ID=scheduled_world_run

# --- Realtime (Socket.IO + relation stream) ---
ENABLE_RELATION_STREAM=true
SOCKETIO_CORS_ORIGINS=*
